<Window x:Class="SynchronizationCompletionCoordinator.Views.UnitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单位信息" Height="220" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FAFAFA" FontFamily="Microsoft YaHei">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 单位名称 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="单位名称：" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtName" Width="280" Height="26" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 执行时间 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="执行时间：" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDays" Width="40" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
            <TextBlock Text=" 天 " VerticalAlignment="Center"/>
            <TextBox x:Name="TxtHours" Width="40" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
            <TextBlock Text=" 时 " VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMinutes" Width="40" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
            <TextBlock Text=" 分 " VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSeconds" Width="40" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
            <TextBlock Text=" 秒" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="28" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>