<Window x:Class="SynchronizationCompletionCoordinator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Width="520" SizeToContent="Height" MinHeight="510"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FAFAFA" FontFamily="Microsoft YaHei">
    <Grid Margin="15,15,15,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一组：时机 -->
        <GroupBox Grid.Row="0" Header="时机设置" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="注意状态时机：" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtAttH" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 时 " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtAttM" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 分 " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtAttS" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 秒" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="警告状态时机：" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtWarnH" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 时 " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWarnM" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 分 " VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWarnS" Width="35" Height="24" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
                    <TextBlock Text=" 秒" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 第二组：可视化 -->
        <GroupBox Grid.Row="1" Header="可视化" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <CheckBox x:Name="ChkCircleProgress" Content="圆形进度条" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkBorderAlert" Content="边框提示" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkBackgroundAlert" Content="背景提示" Margin="0,0,0,8"/>
                <!-- 窗口半透明滑动条设置 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="窗口半透明值：" VerticalAlignment="Center"/>
                    <Slider x:Name="SliderOpacity" Width="240" VerticalAlignment="Center"
                            Minimum="10" Maximum="100" SmallChange="5" LargeChange="5"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="SliderOpacity_ValueChanged"/>
                    <TextBlock x:Name="TxtOpacityValue" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="%" VerticalAlignment="Center" Foreground="#666666"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 第三组：提示音 -->
        <GroupBox Grid.Row="2" Header="提示音" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <!-- 总开关 -->
                <CheckBox x:Name="ChkEnableSound" Grid.Row="0" Grid.ColumnSpan="4" Content="启用提示音" FontWeight="Bold"/>

                <!-- 注意音 -->
                <Button Grid.Row="2" Grid.Column="0" Content="注意状态提示音" Height="24" Click="SelectAttentionSound_Click"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtAttSound" Height="24" Margin="6,0,6,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SoundPath_TextChanged"
                         LostFocus="SoundPath_LostFocus"
                         KeyDown="SoundPath_KeyDown"/>
                <Button Grid.Row="2" Grid.Column="2" Content="试听" Height="24" Margin="0,0,4,0" Click="TestAttSound_Click"/>
                <Button Grid.Row="2" Grid.Column="3" Content="清除" Height="24" Click="ClearAttSound_Click"/>

                <!-- 警告音 -->
                <Button Grid.Row="4" Grid.Column="0" Content="警告状态提示音" Height="24" Click="SelectWarningSound_Click"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtWarnSound" Height="24" Margin="6,0,6,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SoundPath_TextChanged"
                         LostFocus="SoundPath_LostFocus"
                         KeyDown="SoundPath_KeyDown"/>
                <Button Grid.Row="4" Grid.Column="2" Content="试听" Height="24" Margin="0,0,4,0" Click="TestWarnSound_Click"/>
                <Button Grid.Row="4" Grid.Column="3" Content="清除" Height="24" Click="ClearWarnSound_Click"/>

                <!-- 结束音 -->
                <Button Grid.Row="6" Grid.Column="0" Content="计时结束提示音" Height="24" Click="SelectFinishSound_Click"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtFinishSound" Height="24" Margin="6,0,6,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SoundPath_TextChanged"
                         LostFocus="SoundPath_LostFocus"
                         KeyDown="SoundPath_KeyDown"/>
                <Button Grid.Row="6" Grid.Column="2" Content="试听" Height="24" Margin="0,0,4,0" Click="TestFinishSound_Click"/>
                <Button Grid.Row="6" Grid.Column="3" Content="清除" Height="24" Click="ClearFinishSound_Click"/>
            </Grid>
        </GroupBox>

        <!-- 保存/取消 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Height="28" Margin="0,0,10,0" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>