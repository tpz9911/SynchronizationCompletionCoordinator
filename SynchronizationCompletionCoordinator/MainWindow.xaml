<Window x:Class="SynchronizationCompletionCoordinator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SynchronizationCompletionCoordinator"
        xmlns:controls="clr-namespace:SynchronizationCompletionCoordinator.Controls"
        Title="同步完成协调器" Height="600" Width="750"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Microsoft YaHei"
        Icon="/logo.ico">

    <Window.ContextMenu>
        <ContextMenu Opened="WindowContextMenu_Opened">
            <MenuItem x:Name="MenuMaximize" Header="最大化" Click="MenuMaximize_Click"/>
            <MenuItem x:Name="MenuRestore" Header="还原" Click="MenuRestore_Click"/>
            <MenuItem Header="最小化" Click="MenuMinimize_Click"/>
            <Separator/>
            <MenuItem Header="退出程序" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- 进度条样式 -->
        <Style x:Key="FlatProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单元格样式：彻底去除选中蓝色背景，所有内容垂直居中 -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" VerticalAlignment="Stretch">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#111111"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 表头样式：高度与垂直居中 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- 文本列统一居中文本样式 -->
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- 行样式：HorizontalAlignment="Left" 使行边框在最后一列末尾结束，不拉伸到空白处 -->
        <Style x:Key="UnitRowStyle" TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <!-- 外层选中指示 Border -->
                        <Border x:Name="OuterSelectBorder" HorizontalAlignment="Left" BorderBrush="Transparent"
                                BorderThickness="{x:Static local:AppConfig.SelectionBorderThickness}"
                                CornerRadius="4" Padding="1" Background="Transparent">
                            <!-- 内层状态提示 Border -->
                            <Border x:Name="InnerStateBorder" BorderBrush="#DDDDDD"
                                    BorderThickness="{x:Static local:AppConfig.AlertBorderThickness}"
                                    Background="White" CornerRadius="3" MinHeight="32">
                                <SelectiveScrollingGrid>
                                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OuterSelectBorder" Property="BorderBrush" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层根 Border：承载无边框圆角背景与外轮廓 -->
    <Border Background="#F5F6F8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一部分 -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：团队开始时间 & 置顶勾选 -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="团队开始时间：" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtEarliestStartTime" Text="--" FontSize="14" Foreground="#1976D2"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkTopMost" Content="窗口置顶" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkTopMost_Changed" Unchecked="ChkTopMost_Changed"/>
                    </Grid>

                    <!-- 第二行：团队完成时间 & 窗口半透明 -->
                    <Grid Grid.Row="1" Margin="0,6,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="团队完成时间：" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtTeamEndTime" Text="--" FontSize="14" Foreground="#388E3C"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkTransparent" Content="窗口半透明" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkTransparent_Changed" Unchecked="ChkTransparent_Changed"/>
                    </Grid>

                    <!-- 第三行：居中进度条 -->
                    <Grid Grid.Row="2" Height="26">
                        <ProgressBar x:Name="TeamProgressBar" Style="{StaticResource FlatProgressBarStyle}"
                                     Foreground="{x:Static local:AppConfig.TeamProgressBrush}" Minimum="0" Maximum="100" Value="100"/>
                        <TextBlock x:Name="TxtProgressDisplay" Text="等待设定团队时间" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#333333"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 第二部分：预览表格 -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Padding="4">
                <DataGrid x:Name="GridUnits" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True" CanUserResizeColumns="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" Background="Transparent"
                          RowStyle="{StaticResource UnitRowStyle}" SelectionMode="Single"
                          PreviewMouseDown="GridUnits_PreviewMouseDown"
                          MouseDoubleClick="GridUnits_MouseDoubleClick">
                    <DataGrid.Columns>
                        <!-- 单位名称 (右侧圆形进度条距右边框 5 像素) -->
                        <DataGridTemplateColumn Header="单位名称" Width="180" MinWidth="100" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <controls:CircleProgressBar Width="18" Height="18" HorizontalAlignment="Right" Margin="0,0,5,0"
                                                                    Value="{Binding CircleProgressRatio}"
                                                                    StrokeBrush="{x:Static local:AppConfig.CircleProgressBrush}"
                                                                    Visibility="{Binding DataContext.CircleProgressVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 执行用时 -->
                        <DataGridTextColumn Header="执行用时" Binding="{Binding DurationDisplay}" ElementStyle="{StaticResource CenterTextStyle}" Width="100" MinWidth="80" SortMemberPath="Duration"/>

                        <!-- 开始时间 -->
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartTimeDisplay}" ElementStyle="{StaticResource CenterTextStyle}" Width="150" MinWidth="140" SortMemberPath="StartTime"/>

                        <!-- 开始偏离 -->
                        <DataGridTextColumn Header="开始偏离" Binding="{Binding StartOffsetDisplay}" ElementStyle="{StaticResource CenterTextStyle}" Width="100" MinWidth="80" SortMemberPath="StartOffset"/>

                        <!-- 开始倒计时 -->
                        <DataGridTemplateColumn Header="开始倒计时" Width="120" MinWidth="100" SortMemberPath="StartTime">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CountdownDisplay}" Foreground="{Binding CountdownForeground}"
                                               FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 第三部分：功能区域 -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- 2.1.3.1 按钮栏与锁定窗口尺寸 -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="增加单位" Width="80" Height="28" Margin="0,0,8,0" Click="BtnAddUnit_Click"/>
                            <Button Content="删除单位" Width="80" Height="28" Margin="0,0,8,0" Click="BtnDeleteUnit_Click"/>
                            <Button Content="清空列表" Width="80" Height="28" Margin="0,0,8,0" Click="BtnClearUnits_Click"/>
                            <Button Content="设置" Width="80" Height="28" Click="BtnSettings_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkLockWindowResize" DockPanel.Dock="Right" Content="锁定窗口尺寸"
                                  VerticalAlignment="Center" Checked="ChkLockWindowResize_Changed" Unchecked="ChkLockWindowResize_Changed"/>
                    </DockPanel>

                    <!-- 2.1.3.2 团队时间模式 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="团队时间模式：" VerticalAlignment="Center" FontWeight="Bold"/>
                        <RadioButton x:Name="RbStartTime" Content="开始时间" GroupName="TeamMode" IsChecked="True" VerticalAlignment="Center" Margin="6,0,12,0" Checked="Mode_CheckedChanged"/>
                        <RadioButton x:Name="RbEndTime" Content="完成时间" GroupName="TeamMode" VerticalAlignment="Center" Checked="Mode_CheckedChanged"/>
                    </StackPanel>

                    <!-- 2.1.3.3 设置团队时间与作者版本信息 -->
                    <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="团队时间：" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                            <DatePicker x:Name="DpTeamDate" Width="120" Height="26" Margin="0,0,8,0" SelectedDateChanged="TeamTimeInput_Changed"/>
                            <TextBox x:Name="TxtHour" Width="38" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2" TextChanged="TeamTimeInput_Changed"/>
                            <TextBlock Text=" 时 " VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMinute" Width="38" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2" TextChanged="TeamTimeInput_Changed"/>
                            <TextBlock Text=" 分 " VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSecond" Width="38" Height="26" VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" MaxLength="2" TextChanged="TeamTimeInput_Changed"/>
                            <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="应用时间" Width="75" Height="26" Click="BtnApplyTeamTime_Click"/>
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,0,0">
                            <Hyperlink NavigateUri="https://github.com/tpz9911"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       ToolTip="点击访问作者主页">
                                PZ v0.99.260918
                            </Hyperlink>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>